<?xml version="1.0" encoding="UTF-8"?>
<!--
  IMPORTANTE — puerto del backend en las reglas de abajo:
  back-agyda (BackAgyda/server.js, proceso PM2 "back-agyda") escucha en el
  puerto 8447. El puerto 8445 pertenece a OTRO sistema (back-intra /
  BackIntranet) que corre en el MISMO servidor. Si cambias esto a 8445,
  todo el sitio AGYDA (login, API, sockets) devuelve 502/500 porque
  apunta al proceso equivocado. Verificar con `pm2 describe back-agyda`
  el puerto real antes de tocar este archivo. Última vez confirmado: 2026-08-21.

  Este archivo vive en FrontAgyda/public/ porque Vite lo copia tal cual a
  dist/ en cada `npm run build` — es la fuente real que termina en
  C:\inetpub\wwwroot\AGYDA\web.config, NO el archivo de producción editado
  directamente (ese se sobrescribe en el próximo build/deploy).
-->
<configuration>
  <system.webServer>
    <!-- Límite de subida: por default IIS corta en ~30MB (requestFiltering),
         muy por debajo del límite de 100MB que ya tiene multer en
         capacitacionUpload.js (materiales de audio/video). Sin esto, un
         archivo grande nunca llega a Node — IIS responde 413 antes. -->
    <security>
      <requestFiltering>
        <requestLimits maxAllowedContentLength="104857600" />
      </requestFiltering>
    </security>
    <rewrite>
      <rules>
        <!-- Socket.IO -->
        <rule name="SocketIO Proxy" stopProcessing="true">
          <match url="^socket\.io/(.*)" />
          <action type="Rewrite" url="http://localhost:8447/socket.io/{R:1}" />
        </rule>

        <!-- Archivos subidos por el backend (evidencias tickets, CRM, audio) -->
        <rule name="Uploads Proxy" stopProcessing="true">
          <match url="^uploads/(.*)" />
          <action type="Rewrite" url="http://localhost:8447/uploads/{R:1}" />
        </rule>
        <rule name="Audio Proxy" stopProcessing="true">
          <match url="^audio/(.*)" />
          <action type="Rewrite" url="http://localhost:8447/audio/{R:1}" />
        </rule>
        <rule name="CapacitacionMateriales Proxy" stopProcessing="true">
          <match url="^capacitacion-materiales/(.*)" />
          <action type="Rewrite" url="http://localhost:8447/capacitacion-materiales/{R:1}" />
        </rule>

        <!-- API REST -->
        <rule name="API Proxy" stopProcessing="true">
          <match url="^api/(.*)" />
          <action type="Rewrite" url="http://localhost:8447/api/{R:1}" />
        </rule>

        <!-- Dashboard de Gestión Vicidial (Python/FastAPI puerto 8020) -->
        <rule name="GestionVicidial Proxy" stopProcessing="true">
          <match url="^gestion-vicidial/(.*)" />
          <action type="Rewrite" url="http://localhost:8020/{R:1}" />
        </rule>

        <!-- Multimedia estática servida por IIS directamente (Perfil, Portadas, Noticias, etc.)
             La condición IsFile la deja pasar sin rewrite — IIS la sirve directo. -->

        <!-- SPA Fallback: rutas React que no son archivos fisicos -->
        <rule name="SPA Fallback" stopProcessing="true">
          <match url=".*" />
          <conditions logicalGrouping="MatchAll">
            <add input="{REQUEST_FILENAME}" matchType="IsFile"      negate="true" />
            <add input="{REQUEST_FILENAME}" matchType="IsDirectory" negate="true" />
          </conditions>
          <action type="Rewrite" url="/index.html" />
        </rule>
      </rules>
    </rewrite>
  </system.webServer>
</configuration>
