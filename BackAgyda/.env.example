NODE_ENV=development
PORT=8444
HOST=0.0.0.0
USE_HTTPS=false

# Database
DB_SERVER=
DB_NAME=intranet
DB_USER=sa
DB_PASSWORD=
DB_PORT=1433

# JWT
JWT_SECRET=

# Expedientes (documentos cifrados en BD)
# Clave simétrica de 32 bytes (AES-256-GCM) en base64 o hex.
EXPEDIENTE_ENCRYPTION_KEY=
EXPEDIENTE_KEY_ID=v1
EXPEDIENTE_MAX_FILE_MB=50

# Session
SESSION_SECRET=

# Email
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SMTP_DEBUG=false

# Email Recipients
PERMISOS_MAIL_TO=

# Upload Directories
PROFILE_UPLOAD_DIR=
PORTADA_UPLOAD_DIR=
PROFILE_PUBLIC_BASE_URL=
PORTADA_PUBLIC_BASE_URL=
